# The Estimator — frontend environment (copy to .env.local)

# Base URL of the FastAPI backend (all routes under /api).
NEXT_PUBLIC_API_URL=http://localhost:8000

# 1 = render every screen from bundled mock payloads (lib/mock.ts) — no backend
# needed. 0 = real API (default). When the API is unreachable at the network
# level, the client still falls back to mock data and shows an amber banner.
NEXT_PUBLIC_USE_MOCK=0
